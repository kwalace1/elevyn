# Elevyn environment (copy to .env — never commit secrets)

# Preferred AI provider: openrouter | ollama | openai | claude | gemini
# If unset: openrouter when OPENROUTER_API_KEY is present, else ollama
# ELEVYN_AI_PROVIDER=openrouter

# --- OpenRouter (recommended — works locally and on Vercel) ---
# Free signup: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
# OPENROUTER_SITE_URL=https://your-app.vercel.app
# OPENROUTER_APP_NAME=Elevyn

# --- Ollama (local only — not available on Vercel) ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:1b

# ELEVYN_PORT=8787

# Optional Google Calendar (or any ICS) secret feed URL.
# Elevyn merges the next 48h into "what's next" / catch-me-up.
# ELEVYN_CALENDAR_ICS=https://calendar.google.com/calendar/ical/.../basic.ics

# Neural British TTS via edge-tts (local Mac). On Vercel the UI uses browser TTS.
ELEVYN_TTS_VOICE=en-GB-SoniaNeural
# ELEVYN_TTS_PREWARM=0

# --- Frontend ---
# Leave unset. Same-origin /api works for local Vite proxy and Vercel.
# VITE_ELEVYN_API=
# VITE_ELEVYN_TOKEN=
