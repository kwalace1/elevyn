# Elevyn environment (copy to .env — never commit secrets)

# Preferred AI provider: openrouter | ollama | openai | claude | gemini
# If unset: openrouter when OPENROUTER_API_KEY is present, else ollama
# ELEVYN_AI_PROVIDER=openrouter

# --- OpenRouter (recommended — works locally and on Vercel) ---
# Free signup: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
# OPENROUTER_SITE_URL=https://your-app.vercel.app
# OPENROUTER_APP_NAME=Elevyn

# --- Ollama (local only — not available on Vercel) ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:1b

# ELEVYN_PORT=8787

# Optional Google Calendar (or any ICS) secret feed URL.
# Used when Microsoft 365 is not connected. Elevyn merges the next 48h into
# "what's next" / catch-me-up.
# ELEVYN_CALENDAR_ICS=https://calendar.google.com/calendar/ical/.../basic.ics

# --- Microsoft 365 (work/school — Entra ID) ---
# 1. Entra → App registrations → New (single-tenant = your org)
# 2. Platform: Web. Redirect URIs:
#      https://elevyn.vercel.app/api/msauth
#      http://localhost:5173/api/msauth   (Vite proxies to the local brain)
#    Login URL (Vercel-safe single segment): /api/mslogin
# 3. Certificates & secrets → new client secret
# 4. API permissions (delegated): User.Read, offline_access, Calendars.Read,
#    Mail.Read, Chat.Read, OnlineMeetings.Read — grant admin consent if required
# 5. Fill these env vars (Vercel + local .env). Never prefix with VITE_.
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT_ID=        # Directory (tenant) ID — not "common" for work-only
# MS_REDIRECT_URI=https://elevyn.vercel.app/api/msauth
# ELEVYN_TOKEN_SECRET= # long random string — encrypts MS cookies

# Neural British TTS via edge-tts (local + Vercel api/speak.py).
ELEVYN_TTS_VOICE=en-GB-SoniaNeural
# ELEVYN_TTS_RATE=-4%
# ELEVYN_TTS_PITCH=-2Hz
# ELEVYN_TTS_PREWARM=0

# --- Frontend ---
# Leave unset. Same-origin /api works for local Vite proxy and Vercel.
# VITE_ELEVYN_API=
# VITE_ELEVYN_TOKEN=
