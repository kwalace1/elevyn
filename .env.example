# Elevyn environment (copy to .env — never commit secrets)

# Preferred AI provider: openrouter | ollama | openai | claude | gemini
# If unset: openrouter when OPENROUTER_API_KEY is present, else ollama
# ELEVYN_AI_PROVIDER=openrouter

# --- OpenRouter (recommended on Intel / low-RAM Macs) ---
# Free signup: https://openrouter.ai/keys
# Default model uses free auto-router — $0 when using :free / openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# OPENROUTER_SITE_URL=http://localhost:5173
# OPENROUTER_APP_NAME=Elevyn

# --- Ollama (local, fully offline) ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:1b

# ELEVYN_PORT=8787
# Hosted platforms (Railway/Render/Fly) inject PORT — it wins over ELEVYN_PORT.

# Neural British TTS via edge-tts (free). Alternatives: en-GB-RyanNeural, en-GB-LibbyNeural
ELEVYN_TTS_VOICE=en-GB-SoniaNeural

# Set to 0 on low-RAM machines — prewarm spawns Python once per phrase at boot.
# ELEVYN_TTS_PREWARM=0

# --- Hosted brain (cloud deployment) ---
# Marks this instance as hosted: binds 0.0.0.0 and disables Mac-only controls.
# ELEVYN_HOSTED=1
# Shared secret. REQUIRED if the brain is reachable from the internet.
# ELEVYN_API_TOKEN=
# Comma-separated allowed origins. Empty = allow all (local dev only).
# ELEVYN_ALLOWED_ORIGINS=https://your-app.vercel.app

# --- Frontend (build-time, baked into the bundle by Vite) ---
# Where the UI looks for the brain. Leave unset for local development.
# VITE_ELEVYN_API=https://your-brain.up.railway.app
# Must match ELEVYN_API_TOKEN when the brain is gated.
# VITE_ELEVYN_TOKEN=
