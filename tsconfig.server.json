{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-server",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "server/**/*.ts",
    "src/types/**/*.ts",
    "src/utils/agendaParse.ts",
    "src/utils/spokenReply.ts",
    "src/utils/peopleMemory.ts",
    "src/utils/thinkOnGlass.ts"
  ]
}
