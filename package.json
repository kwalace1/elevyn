{
  "name": "elevyn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Elevyn — local-first AI operating system for your room",
  "scripts": {
    "dev": "concurrently -k -n brain,ui -c cyan,magenta \"npm:dev:brain\" \"npm:dev:ui\"",
    "dev:ui": "vite",
    "dev:brain": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "build:brain": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "start": "node dist-server/server/index.js",
    "start:brain": "tsx server/index.ts",
    "lint": "oxlint"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
